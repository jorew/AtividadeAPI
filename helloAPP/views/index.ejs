<!DOCTYPE html>
<html lang="pt-BR">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Mensagem do Dia - Ron Swanson</title>
    <!-- Bootstrap 5 CSS -->
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" rel="stylesheet">
    <style>
        body {
            background: linear-gradient(135deg, #1f2937, #111827);
            min-height: 100vh;
        }
    </style>
</head>
<body class="d-flex align-items-center justify-content-center text-white">

    <div class="container text-center my-5" style="max-width: 650px;">
        <div class="card bg-dark text-white shadow-lg border-secondary rounded-4 p-4">
            <div class="card-body">
                <h1 class="card-title h3 mb-4 text-warning">📜 Mensagem do Dia</h1>

                <% if (quote) { %>
                    <figure class="my-4">
                        <blockquote class="blockquote fs-4 italic">
                            <p>"<%= quote %>"</p>
                        </blockquote>
                        <figcaption class="blockquote-footer text-light mt-2">
                            Ron Swanson
                        </figcaption>
                    </figure>
                <% } else if (error) { %>
                    <div class="alert alert-danger" role="alert">
                        <%= error %>
                    </div>
                <% } %>

                <a href="/" class="btn btn-warning font-weight-bold px-4 py-2 mt-3">
                    🔄 Nova Citação
                </a>
            </div>
        </div>
    </div>

    <!-- Bootstrap JS (opcional) -->
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/js/bootstrap.bundle.min.js"></script>
</body>
</html>